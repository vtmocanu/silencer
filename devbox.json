{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "kics":      "2.1.19",
    "checkov":   "3.3.0",
    "hadolint":  "2.14.0",
    "trivy":     "0.71.2",
    "skopeo":    "1.23.0",
    "infisical": "0.41.90",
    "dive":      "0.13.1",
    "dockle": {
      "version":            "0.4.15",
      "excluded_platforms": ["aarch64-darwin"]
    },
    "kubernetes-helm":          "4.2.1",
    "nodejs_22":                "22.23.0",
    "eslint":                   "10.5.0",
    "kind":                     "0.31.0",
    "kubectl":                  "1.36.2",
    "grype":                    "0.114.0"
  },
  "shell": {
    "init_hook": [
      "[ -z \"$CI\" ] && cat README.md || true"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
