{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "kics":      "2.1.21",
    "checkov":   "3.4.5",
    "hadolint":  "2.14.0",
    "trivy":     "0.76.2",
    "skopeo":    "1.25.1",
    "infisical": "0.45.6",
    "dive":      "0.13.1",
    "dockle": {
      "version":            "0.4.15",
      "excluded_platforms": ["aarch64-darwin"]
    },
    "kubernetes-helm":          "4.3.2",
    "nodejs_22":                "22.23.5",
    "eslint":                   "10.15.0",
    "kind":                     "0.33.0",
    "kubectl":                  "1.37.2",
    "grype":                    "0.122.0"
  },
  "shell": {
    "init_hook": [
      "[ -z \"$CI\" ] && cat README.md || true"
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}
